#!/usr/bin/env bash
# ==============================================================================
# agy-sbx: Containerized Agent Sandbox Orchestrator CLI
# ==============================================================================
# Orchestrates ephemeral, isolated container sandboxes for Google Antigravity
# agents using Git worktrees, rootless Podman, and host credential passthrough.
# Compatible with macOS default Bash 3.2+ and modern Linux Bash.
# ==============================================================================

set -euo pipefail

# Terminal colors (tuned for high-contrast visibility on dark/black backgrounds - no dark blues)
RED='\033[38;5;203m'       # Bright coral red
GREEN='\033[38;5;120m'     # Bright mint green
CYAN='\033[38;5;45m'       # Crisp, luminous electric cyan (replaces all blue)
YELLOW='\033[38;5;221m'    # Warm amber gold
PURPLE='\033[38;5;141m'    # Soft lilac / violet
MUTED='\033[38;5;246m'     # Clean silver gray
BOLD='\033[1m'
NC='\033[0m'               # No Color

# ------------------------------------------------------------------------------
# Logging Helpers
# ------------------------------------------------------------------------------
die() {
    printf "${RED}[ERROR]${NC} %s\n" "$*" >&2
    exit 1
}

info() {
    printf "${CYAN}[INFO]${NC} %s\n" "$*" >&2
}

success() {
    printf "${GREEN}[SUCCESS]${NC} %s\n" "$*" >&2
}

warn() {
    printf "${YELLOW}[WARN]${NC} %s\n" "$*" >&2
}

# Resolve project root (dereferencing symlinks)
resolve_script_dirs() {
    local source="${BASH_SOURCE[0]}"
    while [ -h "$source" ]; do
        local dir
        dir="$(cd -P "$(dirname "$source")" && pwd)"
        source="$(readlink "$source")"
        [[ $source != /* ]] && source="$dir/$source"
    done
    SCRIPT_DIR="$(cd -P "$(dirname "$source")" && pwd)"
    PROJECT_ROOT="$(cd -P "$SCRIPT_DIR/.." && pwd)"
}
resolve_script_dirs

# ==============================================================================
# MODULE: WorktreeManager (Git Isolation & Cleanliness Seam)
# ==============================================================================

worktree_ensure_repo() {
    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        die "Current directory is not inside a git repository."
    fi
}

worktree_get_root() {
    git rev-parse --show-toplevel
}

worktree_ensure_cleanliness() {
    local git_root="$1"
    local git_dir
    git_dir="$(git -C "$git_root" rev-parse --git-dir)"
    [[ "$git_dir" != /* ]] && git_dir="$git_root/$git_dir"
    local exclude_file="$git_dir/info/exclude"

    mkdir -p "$(dirname "$exclude_file")"
    if [ ! -f "$exclude_file" ] || ! grep -q "^\.worktrees/" "$exclude_file" 2>/dev/null; then
        {
            echo ""
            echo "# Auto-generated by agy-sbx: isolate agent worktrees"
            echo ".worktrees/"
        } >> "$exclude_file"
    fi
}

worktree_sanitize_name() {
    local name="${1%/}" # Strip trailing slash
    if [[ ! "$name" =~ ^[a-zA-Z0-9._-]+$ ]]; then
        die "Invalid task name '$name'. Use only alphanumeric characters, dashes, dots, and underscores."
    fi
    echo "$name"
}

worktree_create() {
    local task_name="$1"
    worktree_ensure_repo
    local git_root
    git_root="$(worktree_get_root)"
    task_name="$(worktree_sanitize_name "$task_name")"

    local worktree_dir="$git_root/.worktrees/$task_name"
    local branch_name="agent/$task_name"

    if [ -d "$worktree_dir" ]; then
        die "Worktree for task '$task_name' already exists at '$worktree_dir'. Use 'agy-sbx open $task_name' to attach."
    fi

    worktree_ensure_cleanliness "$git_root"
    mkdir -p "$git_root/.worktrees"

    info "Creating Git worktree for branch '$branch_name' at '$worktree_dir'..."
    if git -C "$git_root" show-ref --verify --quiet "refs/heads/$branch_name"; then
        warn "Branch '$branch_name' already exists. Checking out existing branch into worktree..."
        git -C "$git_root" worktree add "$worktree_dir" "$branch_name" >&2
    else
        git -C "$git_root" worktree add -b "$branch_name" "$worktree_dir" >&2
    fi

    success "Worktree initialized at $worktree_dir"
    echo "$worktree_dir"
}

worktree_open() {
    local task_name="$1"
    worktree_ensure_repo
    local git_root
    git_root="$(worktree_get_root)"
    task_name="$(worktree_sanitize_name "$task_name")"

    local worktree_dir="$git_root/.worktrees/$task_name"

    if [ ! -d "$worktree_dir" ]; then
        die "Worktree for task '$task_name' does not exist at '$worktree_dir'. Use 'agy-sbx new $task_name' to create it."
    fi

    info "Attaching to existing worktree '$task_name' at $worktree_dir"
    echo "$worktree_dir"
}

worktree_acquire() {
    local task_name="$1"
    worktree_ensure_repo
    local git_root
    git_root="$(worktree_get_root)"
    task_name="$(worktree_sanitize_name "$task_name")"

    local worktree_dir="$git_root/.worktrees/$task_name"
    if [ -d "$worktree_dir" ]; then
        worktree_open "$task_name"
    else
        worktree_create "$task_name"
    fi
}

worktree_list() {
    worktree_ensure_repo
    local git_root
    git_root="$(worktree_get_root)"
    local worktrees_base="$git_root/.worktrees"

    echo -e "${BOLD}Active Sandbox Worktrees in $(basename "$git_root"):${NC}"
    echo "================================================================================"

    if [ ! -d "$worktrees_base" ]; then
        echo "No .worktrees directory found in this repository."
        return
    fi

    local count=0
    local original_nullglob
    original_nullglob="$(shopt -p nullglob || true)"
    shopt -s nullglob

    for wt in "$worktrees_base"/*; do
        if [ -d "$wt" ]; then
            count=$((count + 1))
            local task
            task="$(basename "$wt")"
            local branch
            branch="$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")"
            local status_text
            if [ -n "$(git -C "$wt" status --porcelain 2>/dev/null)" ]; then
                status_text="${YELLOW}dirty (uncommitted changes)${NC}"
            else
                status_text="${GREEN}clean${NC}"
            fi
            local last_commit
            last_commit="$(git -C "$wt" log -1 --format="%h - %s (%cr)" 2>/dev/null || echo "No commits")"

            echo -e "  • ${BOLD}$task${NC} [branch: ${PURPLE}$branch${NC}]"
            echo -e "    Path:   $wt"
            echo -e "    Status: $status_text"
            echo -e "    Commit: $last_commit"
            echo ""
        fi
    done

    eval "$original_nullglob"

    if [ $count -eq 0 ]; then
        echo "No active worktrees found under .worktrees/."
    else
        echo "Total active sandbox worktrees: $count"
    fi
}

worktree_remove() {
    local task_name="$1"
    local delete_branch="${2:-false}"

    worktree_ensure_repo
    local git_root
    git_root="$(worktree_get_root)"
    task_name="$(worktree_sanitize_name "$task_name")"

    local worktree_dir="$git_root/.worktrees/$task_name"
    local branch_name="agent/$task_name"

    if [ -d "$worktree_dir" ]; then
        info "Removing worktree at '$worktree_dir'..."
        git -C "$git_root" worktree remove --force "$worktree_dir" 2>/dev/null || rm -rf "$worktree_dir"
        git -C "$git_root" worktree prune
        success "Worktree removed."
    else
        warn "Worktree directory '$worktree_dir' not found. Pruning git worktrees..."
        git -C "$git_root" worktree prune
    fi

    if [ "$delete_branch" = true ]; then
        info "Deleting branch '$branch_name'..."
        if git -C "$git_root" branch -D "$branch_name" 2>/dev/null; then
            success "Branch '$branch_name' deleted."
        else
            warn "Branch '$branch_name' not found."
        fi
    else
        info "Branch '$branch_name' preserved. Pass '-d' or '--delete-branch' to delete branch."
    fi
}

# ==============================================================================
# MODULE: SandboxEngine (Container Lifecycle & Execution Seam)
# ==============================================================================

sandbox_detect_runtime() {
    if command -v podman >/dev/null 2>&1; then
        echo "podman"
    elif command -v docker >/dev/null 2>&1; then
        echo "docker"
    else
        die "Neither 'podman' nor 'docker' is installed in PATH. Please install Podman Desktop on macOS."
    fi
}

sandbox_resolve_image() {
    local target_dir="$1"
    local runtime="$2"
    local git_root
    git_root="$(git -C "$target_dir" rev-parse --show-toplevel 2>/dev/null || echo "$target_dir")"

    # Check for project-specific Dockerfiles
    local custom_dockerfile=""
    if [ -f "$git_root/.sandbox/Dockerfile" ]; then
        custom_dockerfile="$git_root/.sandbox/Dockerfile"
    elif [ -f "$git_root/.devcontainer/Dockerfile" ]; then
        custom_dockerfile="$git_root/.devcontainer/Dockerfile"
    fi

    if [ -n "$custom_dockerfile" ]; then
        local repo_name
        repo_name="$(basename "$git_root" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-')"
        local image_tag="${repo_name}-sandbox:latest"
        info "Found custom Dockerfile at $custom_dockerfile. Building/verifying image '$image_tag'..."
        "$runtime" build -t "$image_tag" -f "$custom_dockerfile" "$git_root" >&2
        echo "$image_tag"
        return
    fi

    # Fallback to universal image
    local universal_image="agy-sandbox:latest"
    if ! "$runtime" image inspect "$universal_image" >/dev/null 2>&1; then
        warn "Universal image '$universal_image' not found locally."
        if [ -f "$PROJECT_ROOT/Dockerfile" ]; then
            info "Building '$universal_image' from $PROJECT_ROOT/Dockerfile..."
            "$runtime" build -t "$universal_image" "$PROJECT_ROOT" >&2
        else
            die "Universal image '$universal_image' not found and cannot locate template Dockerfile at $PROJECT_ROOT/Dockerfile."
        fi
    fi

    echo "$universal_image"
}

# Appends volume mounts and environment variables into caller arrays (mount_args, env_args)
# Designed for Bash 3.2+ compatibility (avoids namerefs 'local -n')
sandbox_append_mounts() {
    local target_workspace="$1"

    mkdir -p "$HOME/.gemini"
    # Ensure macOS virtiofs host files are readable/writable by developer user in container
    chmod -R go+rwX "$HOME/.gemini" 2>/dev/null || true

    mount_args+=(
        "-v" "${target_workspace}:/workspace:rw"
        "-v" "$HOME/.gemini:/home/developer/.gemini:rw"
    )

    if [ -f "$HOME/.gitconfig" ]; then
        mount_args+=("-v" "$HOME/.gitconfig:/home/developer/.gitconfig:ro")
    fi

    # Forward terminal and color capabilities for black/dark terminal backgrounds
    env_args+=(
        "-e" "TERM=${TERM:-xterm-256color}"
        "-e" "COLORTERM=${COLORTERM:-truecolor}"
    )

    # Forward API keys if set on host
    if [ -n "${GEMINI_API_KEY:-}" ]; then
        env_args+=("-e" "GEMINI_API_KEY=$GEMINI_API_KEY")
    fi

    # SSH Authentication Strategy:
    # On macOS, Launchd Unix domain sockets reside in /var/run/com.apple.launchd.*/Listeners.
    # Podman on macOS executes in a Linux VM where /var/run is not shared from the host,
    # and virtiofs cannot bridge Unix domain sockets across hypervisor boundaries.
    # Mounting $SSH_AUTH_SOCK via -v causes: "statfs ...: no such file or directory".
    # Therefore, on macOS we mount ~/.ssh read-only to allow git SSH access without crashing.
    # On native Linux, where host and container share the kernel, we forward $SSH_AUTH_SOCK.
    if [[ "$OSTYPE" == "darwin"* ]]; then
        if [ -d "$HOME/.ssh" ]; then
            mount_args+=("-v" "$HOME/.ssh:/home/developer/.ssh:ro")
        fi
    else
        if [ -n "${SSH_AUTH_SOCK:-}" ] && [ -S "$SSH_AUTH_SOCK" ]; then
            mount_args+=("-v" "$SSH_AUTH_SOCK:/ssh-agent:ro")
            env_args+=("-e" "SSH_AUTH_SOCK=/ssh-agent")
        elif [ -d "$HOME/.ssh" ]; then
            mount_args+=("-v" "$HOME/.ssh:/home/developer/.ssh:ro")
        fi
    fi
}

# Appends runtime flags into caller array (runtime_flags)
sandbox_append_runtime_flags() {
    local runtime="$1"

    runtime_flags+=("--rm")

    # Dynamic TTY allocation: allocate -it only when connected to a real terminal
    if [ -t 0 ] && [ -t 1 ]; then
        runtime_flags+=("-it")
    elif [ -t 0 ]; then
        runtime_flags+=("-i")
    fi

    runtime_flags+=(
        "--privileged"
    )

    if [ "$runtime" = "podman" ]; then
        runtime_flags+=("--userns=keep-id")
    else
        runtime_flags+=("--user" "developer")
    fi
}

sandbox_exec() {
    local target_workspace="$1"
    local is_shell="$2"
    shift 2
    local extra_args=("$@")

    local runtime
    runtime="$(sandbox_detect_runtime)"

    local image
    image="$(sandbox_resolve_image "$target_workspace" "$runtime")"

    info "Target workspace: $target_workspace"
    info "Container runtime: $runtime"
    info "Selected image: $image"

    local mount_args=()
    local env_args=()
    sandbox_append_mounts "$target_workspace"

    local runtime_flags=()
    sandbox_append_runtime_flags "$runtime"

    if [ "$is_shell" = true ]; then
        info "Launching interactive debugging shell in sandbox container..."
        exec "$runtime" run \
            "${runtime_flags[@]}" \
            "${mount_args[@]}" \
            ${env_args[@]+"${env_args[@]}"} \
            --entrypoint /bin/bash \
            "$image" \
            -i
    fi

    # Agent execution mode
    local container_cmd=("/usr/local/bin/agy")
    local has_approve_flag=false

    for arg in ${extra_args[@]+"${extra_args[@]}"}; do
        if [ "$arg" = "--auto-approve" ] || [ "$arg" = "--dangerously-skip-permissions" ]; then
            has_approve_flag=true
            break
        fi
    done

    if [ "$has_approve_flag" = false ]; then
        container_cmd+=("--dangerously-skip-permissions")
    fi

    if [ ${#extra_args[@]} -gt 0 ]; then
        container_cmd+=("${extra_args[@]}")
    fi

    info "Launching ephemeral sandbox container..."
    exec "$runtime" run \
        --entrypoint "" \
        "${runtime_flags[@]}" \
        "${mount_args[@]}" \
        ${env_args[@]+"${env_args[@]}"} \
        "$image" \
        "${container_cmd[@]}"
}

# ==============================================================================
# CLI Subcommands
# ==============================================================================

cmd_help() {
    cat << 'EOF'
agy-sbx: Containerized Agent Sandbox Orchestrator CLI

Usage:
  agy-sbx new <task-name> [-- <agy args>]     Create a new isolated Git worktree and launch agent
  agy-sbx open <task-name> [-- <agy args>]    Re-attach to an existing Git worktree session
  agy-sbx list                               List all active sandbox worktrees and their git status
  agy-sbx rm <task-name> [-d|--delete-branch] Remove a worktree and optionally prune its branch
  agy-sbx current [-- <agy args>]            Run sandbox directly in current directory without worktree
  agy-sbx shell [task-name]                  Launch an interactive bash shell in the sandbox container
  agy-sbx help, -h, --help                   Display this usage guide

Examples:
  agy-sbx new refactor-auth
  agy-sbx new fix-nav -- -p "Fix mobile navbar toggle"
  agy-sbx open refactor-auth
  agy-sbx list
  agy-sbx rm refactor-auth --delete-branch
  agy-sbx current
  agy-sbx shell

Architecture:
  - Ephemeral containers: ~300ms startup, 0% idle CPU/battery
  - Multi-agent isolation: Git worktrees at .worktrees/<task>
  - Credential forwarding: ~/.gemini, ~/.gitconfig, platform-safe SSH
  - Safe nested containers: Rootless Podman aliased to 'docker'
EOF
}

cmd_new() {
    local task_name=""
    if [ $# -lt 1 ] || [ "$1" = "--" ] || [[ "$1" == -* ]]; then
        task_name="task-$(date +%m%d-%H%M%S)"
        info "No task name specified. Auto-generated task name: '$task_name'"
    else
        task_name="$1"
        shift
    fi

    [ "${1:-}" = "--" ] && shift

    local worktree_dir
    worktree_dir="$(worktree_create "$task_name")"
    sandbox_exec "$worktree_dir" false "$@"
}

cmd_open() {
    if [ $# -lt 1 ]; then
        die "Missing task name. Usage: agy-sbx open <task-name> [-- <agy args>]"
    fi

    local task_name="$1"
    shift

    [ "${1:-}" = "--" ] && shift

    local worktree_dir
    worktree_dir="$(worktree_open "$task_name")"
    sandbox_exec "$worktree_dir" false "$@"
}

cmd_list() {
    worktree_list
}

cmd_rm() {
    if [ $# -lt 1 ]; then
        die "Missing task name. Usage: agy-sbx rm <task-name> [-d|--delete-branch]"
    fi

    local task_name="$1"
    shift

    local delete_branch=false
    while [ $# -gt 0 ]; do
        case "$1" in
            -d|--delete-branch)
                delete_branch=true
                ;;
            *)
                warn "Unknown flag '$1'"
                ;;
        esac
        shift
    done

    worktree_remove "$task_name" "$delete_branch"
}

cmd_current() {
    [ "${1:-}" = "--" ] && shift

    local target_dir
    target_dir="$(pwd)"
    info "Running sandbox directly on current directory: $target_dir"
    sandbox_exec "$target_dir" false "$@"
}

cmd_shell() {
    local target_dir
    if [ $# -gt 0 ] && [ -n "$1" ]; then
        worktree_ensure_repo
        local git_root
        git_root="$(worktree_get_root)"
        local task_name
        task_name="$(worktree_sanitize_name "$1")"
        target_dir="$git_root/.worktrees/$task_name"
        if [ ! -d "$target_dir" ]; then
            die "Worktree '$task_name' does not exist at $target_dir."
        fi
    else
        target_dir="$(pwd)"
    fi

    sandbox_exec "$target_dir" true
}

# ==============================================================================
# Main Dispatch
# ==============================================================================

dispatch_context_aware() {
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        local current_dir
        current_dir="$(pwd)"
        if [[ "$current_dir" =~ /\.worktrees/ ]]; then
            cmd_current "$@"
        else
            cmd_new "$@"
        fi
    else
        cmd_current "$@"
    fi
}

main() {
    # If no arguments provided
    if [ $# -eq 0 ]; then
        dispatch_context_aware
        exit 0
    fi

    local command="$1"

    case "$command" in
        new)
            shift
            cmd_new "$@"
            ;;
        open)
            shift
            cmd_open "$@"
            ;;
        list)
            shift
            cmd_list "$@"
            ;;
        rm)
            shift
            cmd_rm "$@"
            ;;
        current)
            shift
            cmd_current "$@"
            ;;
        shell)
            shift
            cmd_shell "$@"
            ;;
        help|--help|-h)
            cmd_help
            ;;
        -*)
            # Directly passed flags e.g. `agy-sbx -p "fix nav"`
            dispatch_context_aware "$@"
            ;;
        *)
            # Passed task name e.g. `agy-sbx my-task`
            if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
                local git_root
                git_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
                local sanitized_cmd="${command%/}"
                shift
                if [ -d "$git_root/.worktrees/$sanitized_cmd" ]; then
                    cmd_open "$sanitized_cmd" "$@"
                else
                    cmd_new "$sanitized_cmd" "$@"
                fi
            else
                die "Unknown command '$command'. Run 'agy-sbx help' for usage instructions."
            fi
            ;;
    esac
}

main "$@"
